{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chapter_index.schema.json",
  "title": "Chapter index (works/<book_id>/chapters/index.json)",
  "description": "Format version 0.1. Produced by tools/normalize_book.py.",
  "type": "object",
  "required": ["schema_version", "book_id", "chapters"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "book_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,30}$" },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter_id", "chapter_no", "title", "char_count", "paragraph_count", "file"],
        "additionalProperties": false,
        "properties": {
          "chapter_id": { "type": "string", "pattern": "^ch[0-9]{3}$" },
          "chapter_no": { "type": "integer", "minimum": 1, "maximum": 999 },
          "title": { "type": "string" },
          "char_count": { "type": "integer", "minimum": 0 },
          "paragraph_count": { "type": "integer", "minimum": 0 },
          "file": { "type": "string", "pattern": "^chapters/ch[0-9]{3}\\.json$" }
        }
      }
    }
  }
}
