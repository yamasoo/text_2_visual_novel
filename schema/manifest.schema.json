{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Asset manifest (one file per book)",
  "description": "Format version 0.1. Lists every asset the game needs and its production status.",
  "type": "object",
  "required": ["schema_version", "book_id", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1" },
    "book_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,30}$" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "i18n": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2,3}(-[A-Za-z]{2,4})?$" },
      "additionalProperties": { "type": "string" }
    },
    "asset": {
      "type": "object",
      "required": ["asset_id", "kind", "file", "status", "license", "used_in"],
      "additionalProperties": false,
      "properties": {
        "asset_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$" },
        "kind": {
          "enum": ["bg", "sprite", "headshot", "cg", "bgm", "ambience", "sfx", "voice", "ui", "font"]
        },
        "names": { "$ref": "#/$defs/i18n" },
        "file": {
          "type": "string",
          "pattern": "^assets/[a-z0-9_]+/[a-z0-9_]+\\.(png|jpg|ogg|opus|wav|ttf|otf)$"
        },
        "status": {
          "enum": ["planned", "generated", "selected", "processed", "final"]
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "format": { "enum": ["png", "jpg", "ogg", "opus", "wav", "ttf", "otf"] }
          }
        },
        "prompt_en": { "type": "string" },
        "negative_prompt": { "type": "string" },
        "seed": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "model": { "type": "string" },
        "loras": { "type": "array", "items": { "type": "string" } },
        "license": { "type": "string" },
        "used_in": {
          "type": "array",
          "items": { "type": "string", "pattern": "^ch[0-9]{3}_sc[0-9]{2}$" }
        },
        "notes": { "type": "string" },
        "deprecated_ids": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,62}$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "final" } } },
          "then": { "properties": { "license": { "minLength": 1 } } }
        }
      ]
    }
  }
}
